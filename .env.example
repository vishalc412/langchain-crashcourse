# LangChain & LangGraph Learning System
# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: OpenAI API Key
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# OPTIONAL: Additional API Keys
# ============================================

# Cohere API Key (for reranking)
# Get from: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your_cohere_api_key_here

# Pinecone API Key (for managed vector database)
# Get from: https://www.pinecone.io/
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment

# ============================================
# OPTIONAL: Model Configuration
# ============================================

# Default LLM Model (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Default Embedding Model (default: text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# OPTIONAL: Vector Store Configuration
# ============================================

# Chroma Persistence Directory
# CHROMA_PERSIST_DIR=./chroma_db

# ============================================
# OPTIONAL: Development Settings
# ============================================

# Enable Debug Mode (default: false)
# DEBUG=false

# Log Level (default: INFO)
# LOG_LEVEL=INFO

# ============================================
# NOTES
# ============================================
# 1. Never commit your actual .env file to version control
# 2. Keep this .env.example updated with new variables
# 3. Use python-dotenv to load environment variables
#
# Usage in Python:
# from dotenv import load_dotenv
# import os
# load_dotenv()
# api_key = os.getenv("OPENAI_API_KEY")
